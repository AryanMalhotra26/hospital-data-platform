# ─────────────────────────────────────────────────────────────
# Example environment file.
# Copy this to server/.env and fill in real values.
#   cp .env.example server/.env
# The real .env is git-ignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────

# --- MySQL connection (read by the mysql2 connection pool) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hospital_app
DB_PASSWORD=change_me
DB_NAME=hospital_db

# --- Auth ---
# Secret used to sign JWT access tokens. Use a long random string in production,
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace_with_a_long_random_secret
# How long an access token stays valid.
JWT_EXPIRES_IN=1h

# --- Server ---
PORT=4000
# Origin of the React dev server, used for CORS.
CLIENT_ORIGIN=http://localhost:5173
